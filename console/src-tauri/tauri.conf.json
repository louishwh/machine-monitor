{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FleetWatch",
  "version": "0.1.2",
  "identifier": "com.fleetwatch.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "./node_modules/.bin/vite",
    "beforeBuildCommand": "./node_modules/.bin/vite build"
  },
  "app": {
    "windows": [
      {
        "title": "FleetWatch",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
