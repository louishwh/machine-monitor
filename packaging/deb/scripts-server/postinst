#!/bin/sh
set -e

# Server deb post-install: create the service user, prepare the TLS dir the
# server writes its self-signed cert to on first boot, then enable (not start —
# pairing_token must be set first). All actions are idempotent so upgrades
# re-run safely.

if [ "$1" = "configure" ]; then
    if ! getent passwd fleetwatch >/dev/null 2>&1; then
        useradd --system --user-group \
            --home-dir /var/lib/fleetwatch --no-create-home \
            --shell /usr/sbin/nologin fleetwatch
    fi

    install -d -m 0750 -o fleetwatch -g fleetwatch /etc/fleetwatch/tls
    if [ -f /etc/fleetwatch/server.toml ]; then
        chown root:fleetwatch /etc/fleetwatch/server.toml
        chmod 0640 /etc/fleetwatch/server.toml
    fi
    if [ -f /etc/fleetwatch/tls/key.pem ]; then
        chown fleetwatch:fleetwatch /etc/fleetwatch/tls/key.pem
        chmod 0600 /etc/fleetwatch/tls/key.pem
    fi
    if [ -d /var/lib/fleetwatch ]; then
        chown fleetwatch:fleetwatch /var/lib/fleetwatch
        chmod 0700 /var/lib/fleetwatch
    fi
    for db_file in /var/lib/fleetwatch/fleetwatch.db \
                   /var/lib/fleetwatch/fleetwatch.db-wal \
                   /var/lib/fleetwatch/fleetwatch.db-shm; do
        if [ -f "$db_file" ]; then
            chown fleetwatch:fleetwatch "$db_file"
            chmod 0600 "$db_file"
        fi
    done

    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload || true
        if systemctl is-active --quiet fleetwatch-server.service 2>/dev/null; then
            systemctl restart fleetwatch-server.service
            echo "FleetWatch server upgraded and restarted."
        else
            systemctl enable fleetwatch-server.service || true
            echo "FleetWatch server installed."
            echo "Next: edit /etc/fleetwatch/server.toml (set pairing_token,"
            echo "      run: openssl rand -hex 16), then:"
            echo "      systemctl start fleetwatch-server"
        fi
    fi
fi

exit 0
